# Environment Configuration for Offline Corpus-Building Pipeline

# Logging
LOG_LEVEL=INFO

# Paths (relative to project root or absolute)
DATA_RAW_DIR=data/raw
DATA_PARSED_DIR=data/parsed
DATA_CHUNKS_DIR=data/chunks
CHROMA_PERSIST_DIR=vector_db/chroma

# Chroma Collections
LEGAL_COLLECTION_NAME=legal_corpus
SCIENTIFIC_COLLECTION_NAME=scientific_corpus

# Embeddings
SCIENTIFIC_EMBEDDING_MODEL=allenai/specter2_base
LEGAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
DATA_EMBEDDINGS_DIR=data/embeddings

# Chunking
SCIENTIFIC_MAX_CHUNK_TOKENS=512
SCIENTIFIC_CHUNK_OVERLAP=64
LEGAL_MAX_CHUNK_TOKENS=512
